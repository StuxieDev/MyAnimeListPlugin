<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.MyAnimeList</RootNamespace>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the server at runtime, so none of these are shipped in the plugin ZIP. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.3.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <!-- The sync API controller. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of Jellyfin, so these DLLs are shipped next to the plugin's own. -->
    <PackageReference Include="FuzzierSharp" Version="3.0.1" />
    <PackageReference Include="JikanDotNet" Version="2.10.4" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Sync\Configuration\*.html;Sync\Configuration\*.js" />
    <EmbeddedResource Include="Sync\Configuration\*.html;Sync\Configuration\*.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestProject" />
  </ItemGroup>

</Project>
